# ==============================================================================
# Global Opportunity Desk (GOD) API - Environment Configuration Template
# Path on VPS: /opt/god/${APP_ENV}/api.env (e.g. /opt/god/staging/api.env)
# ==============================================================================
# Security Notice:
# 1. This file must be chmod 600, owned by deploy:deploy on the host.
# 2. Never commit production or staging values to version control.
# 3. Each deployment environment (staging, production) MUST have distinct secrets.
# ==============================================================================

# Core runtime environment (Staging & Production MUST use NODE_ENV=production)
NODE_ENV=production
PORT=4000

# Environment identifier: staging | production | development (SEC-112)
APP_ENV=staging

# Release commit SHA (injected automatically during deployment by god-deploy)
RELEASE_SHA=

# Allowed CORS origins (comma-separated, no wildcards, SEC-022)
# Staging: https://staging-admin.globalopportunitydesk.com,https://staging.globalopportunitydesk.com
# Production: https://admin.globalopportunitydesk.com,https://globalopportunitydesk.com
CORS_ORIGIN=https://staging-admin.globalopportunitydesk.com,https://staging.globalopportunitydesk.com

# Cookie Domain (SEC-005, SEC-040)
# Leave unset or empty for host-only cookies, or set to .globalopportunitydesk.com for subdomain sharing
COOKIE_DOMAIN=

# MongoDB Atlas connection string (separate database per environment)
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/god-staging?retryWrites=true&w=majority

# Redis connection string (points to the co-located Redis container on the internal compose network)
REDIS_URL=redis://redis:6379

# Cryptographic Secrets (Minimum 64-character base64 / 32+ bytes of entropy)
# Generate via: openssl rand -base64 48
JWT_SECRET=replace_with_64_char_base64_secret_for_user_auth
ADMIN_JWT_SECRET=replace_with_distinct_64_char_base64_secret_for_admin_auth

# Cloudinary Media Storage (separate folder or sub-account recommended per environment)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External Integrations (Optional / As needed)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Global Opportunities <verify@globalopportunitydesk.com>
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
OUTBOUND_REQUEST_TIMEOUT_MS=10000

# AI Provider Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_SYSTEM_PROMPT="You are the Global Opportunities assistant. Give accurate, helpful opportunity guidance."

# WordPress Integration
INSIGHT_GHANA_WORDPRESS_URL=
AFRICAN_JOURNAL_WORDPRESS_URL=
WORDPRESS_SYNC_BASE_URL=
WORDPRESS_API_KEY=

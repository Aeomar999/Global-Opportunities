# Development - use your computer's LAN IP for physical device testing (Expo Go)
# Get your LAN IP with: ipconfig (Windows) or ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000/api

# For local web/emulator testing on same machine, use:
# EXPO_PUBLIC_API_URL=http://localhost:4000/api

# For production (deployed backend):
# EXPO_PUBLIC_API_URL=https://your-backend-domain.com/api
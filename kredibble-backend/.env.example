NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# MongoDB Atlas.
# Prefer the standard mongodb:// URI if your local network has mongodb+srv DNS TXT timeouts.
DATABASE_URL="mongodb+srv://atlas_user:atlas_password@cluster0.example.mongodb.net/kredibble?retryWrites=true&w=majority&appName=Cluster0"

JWT_SECRET=jwt_secret_placeholder
ADMIN_JWT_SECRET=admin_jwt_secret_placeholder
STORAGE_BUCKET=kredibble-local
STORAGE_ACCESS_KEY=storage_access_key_placeholder
STORAGE_SECRET_KEY=storage_secret_key_placeholder

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=cloudinary_cloud_name_placeholder
CLOUDINARY_API_KEY=cloudinary_api_key_placeholder
CLOUDINARY_API_SECRET=cloudinary_api_secret_placeholder

# AI assistant. Set AI_PROVIDER to openai or anthropic. API keys are never exposed to clients.
AI_PROVIDER=openai
OPENAI_API_KEY=openai_api_key_placeholder
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=anthropic_api_key_placeholder
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# WordPress JSON API base URLs. Use the site root; /wp-json/wp/v2 is added by the API.
INSIGHT_GHANA_WORDPRESS_URL=insight_ghana_wordpress_url_placeholder
AFRICAN_JOURNAL_WORDPRESS_URL=african_journal_wordpress_url_placeholder

# Resend email verification
RESEND_API_KEY=resend_api_key_placeholder
RESEND_FROM_EMAIL=Kredibble <verify@example.com>
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10

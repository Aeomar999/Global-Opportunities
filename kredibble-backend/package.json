{
    "name": "kredibble-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "overrides": {
        "ioredis": "^5.4.1"
    },
    "scripts": {
        "dev": "node --watch --import ./src/instrument.js src/server.js",
        "start": "node --import ./src/instrument.js src/server.js",
        "db:init": "node scripts/init-db.js",
        "db:migrate": "node scripts/migrate.js",
        "db:migrate:status": "node scripts/migrate.js --status",
        "db:seed:test": "node scripts/seed-test-credentials.js",
        "user:create-admin": "node scripts/create-admin.js",
        "accounts:complete-deletions": "node scripts/complete-account-deletions.js",
        "retention:cleanup": "node -e \"import('./src/lib/data-retention.js').then(m => m.runDataRetentionSweep())\",",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "lint": "eslint .",
        "e2e:server": "node --import ./src/instrument.js scripts/e2e-server.js"
    },
    "dependencies": {
        "@sentry/node": "^8.55.2",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.11.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^18.0.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.7.0",
        "file-type": "^22.1.1",
        "helmet": "^7.1.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^7.6.0",
        "mongoose": "^9.10.1",
        "mongoose-to-swagger": "^1.5.1",
        "morgan": "^1.10.0",
        "multer": "^2.4.0",
        "pino": "^10.3.1",
        "pino-http": "^10.5.0",
        "pino-pretty": "^13.1.3",
        "rate-limit-redis": "^6.0.1",
        "resend": "^6.30.0",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.26.0",
        "@eslint/js": "^9.39.5",
        "babel-jest": "^30.5.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "ioredis-mock": "^8.13.1",
        "jest": "^30.5.2",
        "mongodb-memory-server": "^11.3.0",
        "openapi-to-postmanv2": "^6.3.3",
        "socket.io-client": "^4.8.4",
        "supertest": "^7.3.0"
    }
}
